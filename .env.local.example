# Copie ce fichier en .env.local et remplis les valeurs
# (Project Settings -> API dans ton projet Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Serveur uniquement — NE JAMAIS mettre cette clé dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=

# API-SPORTS (même clé utilisable pour Football, NBA et NFL)
API_SPORTS_KEY=

# Secret pour les tâches planifiées Netlify
CRON_SECRET=
